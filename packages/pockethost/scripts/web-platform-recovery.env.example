# Modèle des variables de la reprise globale. Copier en fichier privé (mode 0600,
# propriétaire = utilisateur du service), référencé par EnvironmentFile= de
# pockethost-platform-recovery.service. Ne jamais versionner les valeurs réelles.

# --- Service et contrôleur -----------------------------------------------------
# Répertoire d’état partagé (0700). Doit AUSSI figurer dans l’environnement du
# contrôleur (mothership) pour /api/web-platform-recovery*.
#WEB_PLATFORM_RECOVERY_STATE_DIR=/home/<utilisateur>/.local/state/pockethost-recovery
# Préfixe S3 des captures. Défaut : <platform>/platform-recovery (platform du config.json).
#WEB_PLATFORM_RECOVERY_PREFIX=app1/platform-recovery
# Côté contrôleur seulement : pilote appelé par recovery.ts (défaut ci-dessous).
#WEB_PLATFORM_RECOVERY_RUNNER=/opt/pockethost-web/web_platform_recovery_service.py

# --- Bucket des captures (prioritaire sur WEB_BACKUPS_S3_*) ---------------------
# HTTPS sur le port 443 uniquement ; bucket en minuscules.
#WEB_PLATFORM_S3_ENDPOINT=https://s3.<region>.<fournisseur>
#WEB_PLATFORM_S3_BUCKET=<bucket>
#WEB_PLATFORM_S3_ACCESS_KEY_ID=<identifiant>
#WEB_PLATFORM_S3_SECRET_ACCESS_KEY=<secret>
#WEB_PLATFORM_S3_REGION=gra

# --- Sauvegardes web référencées par les captures -------------------------------
# Même bucket que les sauvegardes des sites : les objets sont copiés côté serveur.
#WEB_BACKUPS_S3_PREFIX=app1/web-app-backups
# Utilisées seulement pour vérifier que la clé de reprise en diffère (jamais copiées).
#WEB_BACKUPS_S3_IMAGE_KEY=<64 hex>
#WEB_APPS_MASTER_KEY=<32 caractères>
# Secret du worker, repli des notifications d’échec si failureEvents.secretFile est vide.
#WEB_APPS_WORKER_SECRET=<32+ caractères>

# --- Configuration privée JSON (config.json, mode 0600) -------------------------
# Champs requis : version=1, stateDir, planFile, keyFile, drillRoot,
#   controlUrl (http://127.0.0.1:<port>), superuserIdentity, superuserPasswordFile.
# Facultatifs (défaut) :
#   platform ("app1")              identifiant de la plateforme, identique au plan
#   executionEnabled (true)        verrou d’exécution, lu au démarrage
#   drillSelect (["controller"])   bases du test du dashboard, contrôleur obligatoire
#   drillMinFreeGiB (15), maxDrillBytes (2 Gio), preflightTimeoutSeconds (3600),
#   captureTimeoutSeconds (14400), adminUserId (compte superAdmin à usurper)
#   drillVerify (true)             contrôle --verify-only après chaque test
#   drillCleanup (true)            suppression de drillRoot/<runId>, rapport conservé
#   sweepEnabled (true), sweepMinAgeHours (48)   nettoyage des envois S3 orphelins
#   planFromInventory (false), dataRoot          instances recalculées à chaque capture
#   protectCustomerBackups (true)  ne crée une archive de site que si la rétention du site n’évince
#                                  que des archives créées par ce service ; sinon réutilise la plus récente
#   failureEvents {enabled:false, path:"/api/web-apps/_platform/recovery-events",
#                  secretFile:""}  événement d’échec vers le contrôleur (à câbler)
