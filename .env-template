APP_URL=https://app.pockethost.io
# Origin IP shown in the dashboard top bar (public build setting).
PUBLIC_SERVER_IP=
BLOG_URL=https://pockethost.io
# Defaults to http: when NODE_ENV=development (pnpm dev / dev:cli)
HTTP_PROTOCOL=https:
APEX_DOMAIN=pockethost.io
DEBUG=false
# Shared secret for internal daemon APIs (vacuum locks, firewall CIDR bypass). Dev defaults to "dev" when unset.
PH_SECRET=
# Stable edge identifier for fleet stats heartbeats (defaults to hostname).
PH_EDGE_ID=
# Dev default: instance cron webhooks off. Set PH_ENABLE_INSTANCE_WEBHOOKS=1 to test locally.
# PH_DISABLE_INSTANCE_WEBHOOKS=true
# Dev default: firewall rate limiting off. Set PH_ENABLE_FIREWALL_RATE_LIMIT=1 to test locally.
# PH_DISABLE_FIREWALL_RATE_LIMIT=true
MOTHERSHIP_ADMIN_USERNAME=
MOTHERSHIP_ADMIN_PASSWORD=
IPCIDR_LIST=
DAEMON_PORT=3000
MOTHERSHIP_PORT=8091
DAEMON_PB_IDLE_TTL=5000
MOTHERSHIP_MIGRATIONS_DIR=/path/to/dist/mothership-app/migrations
MOTHERSHIP_HOOKS_DIR=/path/to/dist/mothership-app/pb_hooks
DAEMON_DATA_ROOT=/path/to/.pockethost/data
DAEMON_INITIAL_PORT_POOL_SIZE=20
PH_FTP_PORT=21
SSL_KEY=/path/to/pockethost.key
SSL_CERT=/path/to/pockethost.crt
PH_FTP_PASV_IP=127.0.0.1
PH_FTP_PASV_PORT_MIN=10000
PH_FTP_PASV_PORT_MAX=20000
PH_SFTP_PORT=2222
MOTHERSHIP_SEMVER=

INSTANCE_APP_MIGRATIONS_DIR=/path/to/dist/instance-app/migrations
INSTANCE_APP_HOOKS_DIR=/path/to/dist/instance-app/pb_hooks

# Exact trusted source hosts (comma separated) for server-to-server transfers.
# Example on app2: INSTANCE_TRANSFER_ALLOWED_HOSTS=app.monappli.re
INSTANCE_TRANSFER_ALLOWED_HOSTS=
# Maximum incoming compressed archive size (default 100 GiB).
INSTANCE_TRANSFER_MAX_BYTES=107374182400

# Optional Next.js hosting (pilot on app.monappli.re only).
WEB_APPS_ENABLED=false
# WEB_APPS_ROOT=/home/pockethost-web/data
# WEB_APPS_PUBLIC_IP=141.94.92.92
# WEB_APPS_DOMAIN_HELPER=/home/ubuntu/pockethost/packages/pockethost/scripts/web_app_domains.py
# WEB_APPS_MASTER_KEY=<32 random ASCII characters, controller only>
# WEB_APPS_WORKER_SECRET=<random shared secret, at least 32 characters>
# PUBLIC_WEB_APPS_ENABLED=true  # dashboard build-time flag
# Optional per-application localhost database bridge (installed separately).
WEB_DB_BRIDGE_ENABLED=false
# WEB_DB_BRIDGE_SECRET=<installer generated; controller and broker only>
# WEB_DB_TARGET_IMAGE=node@sha256:<approved immutable Node image; controller only>
# WEB_DB_BRIDGE_CONTROL=http://127.0.0.1:8091  # broker only
# Web backup worker only, in its private web-apps.env (never dashboard build vars):
# WEB_BACKUPS_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
# WEB_BACKUPS_S3_BUCKET=<private bucket>
# WEB_BACKUPS_S3_REGION=gra
# WEB_BACKUPS_S3_PREFIX=app1/web-app-backups
# WEB_BACKUPS_S3_ACCESS_KEY_ID=<dedicated scoped access key>
# WEB_BACKUPS_S3_SECRET_ACCESS_KEY=<secret>
# WEB_BACKUPS_S3_IMAGE_KEY=<64 hex characters; back up separately from S3>
